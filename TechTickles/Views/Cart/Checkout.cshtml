<div>
    <h1 style="margin-bottom: 30px;">Checkout</h1>
    <div class="container" style="display: flex; flex-direction: row; align-items: c;"> 
        <div style="margin-right: 20px;">
            <h4 style="style: margin: 10px;">Plan: @Model.SubscriptionPlan.Name</h4>
        </div>
        <div>
            <h4 style="style: margin: 10px;">Price: @Model.SubscriptionPlan.Price.ToString("C") per year</h4>
        </div>
    </div>
    <div style="margin-top: 30px;">

        <form asp-controller="Checkout" asp-action="Checkout" method="post">
            <div class="mb-3">
                <label class="form-label">Card Number</label>
                <input name="CardNumber" class="form-control" type="text"  required pattern="^\d{15,16}$" title="Type a Valid 15-16 digit card number required"/>
            </div>
            <div class="mb-3">
                <label class="form-label">Expiration</label>
                <input name="Expiration" class="form-control" type="text" required pattern="^(0[1-9]|1[0-2])\/?([0-9]{4}|[0-9]{2})$" title="Invalid Expiration Date (MM/YYYY or MM/YY)"/>
            </div>
            <div class="mb-3">
                <label class="form-label">CVV</label>
                <input name="CVV" class="form-control" type="text" required pattern="^\d{3,4}$" title="Type a Valid 3-4 digit CVV" />
            </div>
            <div class="mb-3">
                <label class="form-label">Type</label>
                <select name="Type" class="form-select" required>
                    <option value="Visa">Visa</option>
                    <option value="Mastercard">Mastercard</option>
                    <option value="Amex">Amex</option>
                    <option value="Discover">Discover</option>
                </select>
            </div>
            <button type="submit" class="btn btn-success">Confirm Payment</button>
        </form>
        
    </div>
</div>