@model List<TechTickles.Models.Feature>

<div class="container">

   <div class="container-fluid d-flex justify-content-center align-items-center" style="background-image: url('/Images/HomeImg.jpg'); background-size: cover; background-position: center; height: 400px; border-radius: 10px;">
    <p class="display-5 text-white" style="background-color: rgba(0, 0, 0, 0.6); border-radius: 15px; padding: 20px;">
        Not Even A Tickle Can Touch Your Data
    </p>
    </div>

    <div class="container" style="margin-top: 50px;">
        <div class="display-6">
            Stay Protected With Our Services
        </div>
        <div class="container text-center" style="margin-top: 15px;">
            <div class="row row-cols-1 row-cols-md-3 g-4">
                @for (int i = 1; i < Model.Count; i++)
                {
                    var feature = Model[i];
                    
                    <div class="col d-flex">
                        <div class="card shadow-sm p-3 flex-fill d-flex flex-column" style="border-radius: 15px;">
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title">@feature.Name</h5>
                                <p class="card-text mt-auto">@feature.Descripton</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>


