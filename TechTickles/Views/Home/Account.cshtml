<div class="container">
        <div class="display-6">
           Welcome, @Model.FirstName @Model.LastName
        </div>
        <div class="container">
            <div class="row row-cols-1">
                
                    <div class="col d-flex" style="margin-top: 50px;">
                        <div class="card shadow-sm p-3 flex-fill d-flex flex-column" style="border-radius: 15px;">
                            <div class="card-body d-flex flex-column">
                                <h3 class="card-title"> Account Information</h3>
                                <p class="card-text mt-auto">
                                    <p><strong>Your Email:</strong> @Model.Email</p>
                                    <p><strong>Your Username:</strong> @Model.UserName</p>
                                    <p><strong>Your Password:</strong> @Model.Password</p>
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="col d-flex" style="margin-top: 50px;">
                        <div class="card shadow-sm p-3 flex-fill d-flex flex-column" style="border-radius: 15px;">
                            <div class="card-body d-flex flex-column">
                                <h3 class="card-title">Subscription Information</h3>
                                <p class="card-text mt-auto">
                                    @if(Model.Subscription != null)
                                    {
                                        <p><strong>Plan Name:</strong> @Model.Subscription.Plan.Name</p>
                                        <p><strong>Description:</strong> @Model.Subscription.Plan.Description</p>
                                        <p><strong>Price:</strong> $@Model.Subscription.Plan.Price per year</p>
                                        <p><strong>Subscription Start Date:</strong> @Model.Subscription.StartDate.ToShortDateString()</p>
                                        <p><strong>Subscription End Date:</strong> @Model.Subscription.EndDate.ToShortDateString()</p>
                                        
                                        <form asp-action="CancelSubscription" asp-controller="Account" method="post">
                                            <button type="submit" class="btn btn-danger">Cancel Subscription</button>
                                        </form>

                                    }
                                    else
                                    {
                                        <h5>You do not have an active subscription</h5>
                                    }
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="col d-flex" style="margin-top: 50px;">
                        <div class="card shadow-sm p-3 flex-fill d-flex flex-column" style="border-radius: 15px;">
                            <div class="card-body d-flex flex-column">
                                <h3 class="card-title">Card Information</h3>
                                <p class="card-text mt-auto">
                                    @if (Model.cardInfo != null)
                                    {
                                        <p><strong>Card Number:</strong> @Model.cardInfo.CardNumber</p>
                                        <p><strong>Expiry Date:</strong> @Model.cardInfo.Expiration</p>
                                        <p><strong>CVV:</strong> @Model.cardInfo.CVV</p>
                                        <p><strong>Card Type:</strong> @Model.cardInfo.Type</p>
                                    }
                                    else
                                    {
                                        <h5>You do not have a linked Card</h5>
                                    }

                                    <div style="display: flex; flex-direction: row; gap: 20px; margin-top: 20px;">

                                        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#CardModal">
                                            Change or Add Card
                                        </button>

                                        <form asp-action="RemoveCard" asp-controller="Account" method="post">
                                            <button type="submit" class="btn btn-danger">Remove Card</button>
                                        </form>
                                    </div>
                                </p>
                            </div>
                        </div>
                    </div>
            </div>
        </div>
    </div>


<div class="modal fade" id="CardModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true"> 
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h1 class="modal-title fs-5" id="exampleModalLabel">Add or Change Card</h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">

        <form asp-controller="Account" asp-action="UpdateCard" method="post">
            <div class="mb-3">
                <label class="form-label">Card Number</label>
                <input name="CardNumber" class="form-control" type="text"  required pattern="^\d{15,16}$" title="Type a Valid 15-16 digit card number required"/>
            </div>
            <div class="mb-3">
                <label class="form-label">Expiration</label>
                <input name="Expiration" class="form-control" type="text" required pattern="^(0[1-9]|1[0-2])\/?([0-9]{4}|[0-9]{2})$" title="Invalid Expiration Date (MM/YYYY or MM/YY)"/>
            </div>
            <div class="mb-3">
                <label class="form-label">CVV</label>
                <input name="CVV" class="form-control" type="text" required pattern="^\d{3,4}$" title="Type a Valid 3-4 digit CVV" />
            </div>
            <div class="mb-3">
                <label class="form-label">Type</label>
                <select name="Type" class="form-select" required>
                    <option value="Visa">Visa</option>
                    <option value="Mastercard">Mastercard</option>
                    <option value="Amex">Amex</option>
                    <option value="Discover">Discover</option>
                </select>
            </div>
            <button type="submit" class="btn btn-success">Confirm Payment</button>
        </form>

      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>